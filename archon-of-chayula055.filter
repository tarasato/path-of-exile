#===============================================================
# POE2 Unique Highlight (ไฮไลต์อย่างเดียว ไม่ซ่อนอะไร)
# เสียงเดิม: PlayAlertSound 1 300
# สีใกล้เคียงเดิม (แดง/ขาว) แต่เด่นขึ้น: พื้นหลังทึบ 100% และสว่างขึ้น
#
# ฟิลเตอร์จับที่ "ฐานไอเทม" + Rarity Unique ดังนั้นยูนีคอื่นบนฐานเดียวกัน
# จะถูกไฮไลต์ด้วย
#
# Essentia Sanguis      -> Furtive Wraps
# Powertread            -> Hunting Shoes
# Redflare Conduit      -> Anchorite Garb
# Atsak's Sight         -> Veiled Mask
# Carnage Heart         -> Amber Amulet
# Original Sin          -> Amethyst Ring
# Darkness Enthroned    -> Fine Belt
# Golden Obi            -> Golden Obi (ตรวจชื่อฐานในเกมให้ตรง)
#===============================================================

Show
    BaseType == "Furtive Wraps" "Hunting Shoes" "Anchorite Garb" "Veiled Mask" "Amber Amulet" "Amethyst Ring" "Fine Belt" "Golden Obi"
    Rarity Unique
    SetFontSize 45
    SetTextColor 255 255 255 255
    SetBorderColor 255 40 40 255
    SetBackgroundColor 200 0 0 255
    PlayAlertSound 1 300
    PlayEffect Red
    MinimapIcon 0 Red Star

#--- Normal (ของขาว) ฐานเดียวกัน สำหรับเอาไปคราฟต์เอง ----------
# เสียงเดิมแต่เบาลง (V = 100) สีขาว/ฟ้าให้ต่างจากยูนีค
# ถ้าต้องการเฉพาะ ilvl สูง เอา # หน้า ItemLevel ออก
Show
    BaseType == "Furtive Wraps" "Hunting Shoes" "Anchorite Garb" "Veiled Mask" "Amber Amulet" "Amethyst Ring" "Fine Belt" "Golden Obi"
    Rarity Normal
    # ItemLevel >= 81
    SetFontSize 40
    SetTextColor 255 255 255 255
    SetBorderColor 80 200 255 255
    SetBackgroundColor 0 70 110 255
    PlayAlertSound 1 100
    PlayEffect Cyan
    MinimapIcon 1 Cyan Circle